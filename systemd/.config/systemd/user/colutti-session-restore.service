[Unit]
Description=Restore workstation applications after Hyprland is ready
After=dms.service xdg-desktop-portal.service xdg-desktop-portal-hyprland.service
Wants=dms.service xdg-desktop-portal-hyprland.service
ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE

[Service]
Type=oneshot
ExecStart=%h/.local/bin/colutti-session-restore
RemainAfterExit=yes

[Install]
WantedBy=graphical-session.target
