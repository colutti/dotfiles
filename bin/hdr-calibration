#!/usr/bin/env bash
set -euo pipefail
script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_root="${COLUTTI_DESKTOP_ROOT:-$(cd -- "$(dirname -- "${script_path}")/.." && pwd)}"
if command -v hyprctl >/dev/null && command -v jq >/dev/null \
  && hyprctl clients -j | jq -e '.[] | select(.class == "hdr_calibration.py")' >/dev/null; then
  hyprctl eval 'hl.dispatch(hl.dsp.focus({ window = "class:^hdr_calibration\\.py$" }))' >/dev/null
  exit 0
fi
exec python "${repo_root}/desktopctl/hdr_calibration.py" "$@"
