#!/usr/bin/env bash
# Launch a Steam game in native 4K HDR, restoring the SDR desktop afterwards.
set -euo pipefail

if (( $# == 0 )); then
  printf 'usage: game-hdr COMMAND [ARGUMENT ...]\n' >&2
  exit 64
fi

if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
  printf 'game-hdr requires an active Hyprland session\n' >&2
  exit 1
fi

enable_hdr() {
  hyprctl eval 'hl.monitor({ output = "DP-2", mode = "3840x2160@60", position = "0x0", scale = 1.666667, bitdepth = 10, cm = "hdr", supports_wide_color = 1, supports_hdr = 1, min_luminance = 0.25, max_luminance = 480, max_avg_luminance = 302, vrr = 0 })'
}

restore_sdr() {
  hyprctl eval 'hl.monitor({ output = "DP-2", mode = "3840x2160@60", position = "0x0", scale = 1.666667, bitdepth = 8, cm = "srgb", supports_wide_color = 0, supports_hdr = 0, vrr = 0 })' >/dev/null 2>&1 || true
}

enable_hdr
trap restore_sdr EXIT INT TERM
PROTON_ENABLE_HDR=1 DXVK_HDR=1 \
  game-performance gamemoderun \
  gamescope -f -W 3840 -H 2160 -w 3840 -h 2160 --hdr-enabled --mangoapp -- \
  "$@"
