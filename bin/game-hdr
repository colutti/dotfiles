#!/usr/bin/env bash
# Launch a Steam game in native 4K HDR.
# DP-2 HDR is managed permanently by the desktop configuration.
set -euo pipefail

if (( $# == 0 )); then
  printf 'usage: game-hdr COMMAND [ARGUMENT ...]\n' >&2
  exit 64
fi

PROTON_ENABLE_HDR=1 DXVK_HDR=1 \
  game-performance gamemoderun \
  gamescope -f -W 3840 -H 2160 -w 3840 -h 2160 --hdr-enabled --mangoapp -- \
  "$@"
