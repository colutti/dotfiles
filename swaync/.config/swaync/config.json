{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "center",
  "layer": "overlay",
  "control-center-layer": "overlay",
  "control-center-margin-top": 0,
  "control-center-margin-right": 10,
  "control-center-exclusive-zone": false,
  "notification-window-preferred-output": "DP-2",
  "control-center-width": 480,
  "notification-window-width": 440,
  "fit-to-screen": true,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "image-visibility": "when-available",
  "transition-time": 180,
  "timeout": 8,
  "timeout-low": 5,
  "timeout-critical": 0,
  "hide-on-clear": false,
  "hide-on-action": true,
  "relative-timestamps": true,
  "text-empty": "Nenhuma notificação",
  "widgets": [
    "title",
    "dnd",
    "volume",
    "mpris",
    "title#system",
    "buttons-grid#system",
    "title#session",
    "buttons-grid#session",
    "title#power",
    "buttons-grid#power",
    "title#help",
    "buttons-grid#help",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Central",
      "clear-all-button": true,
      "button-text": "Limpar"
    },
    "dnd": {
      "text": "Não perturbe"
    },
    "volume": {
      "label": "Volume",
      "show-per-app": true,
      "show-per-app-icon": true,
      "show-per-app-label": true,
      "expand-per-app": false,
      "empty-list-label": "Nenhum aplicativo reproduzindo áudio"
    },
    "mpris": {
      "autohide": true,
      "show-album-art": "when-available",
      "loop-carousel": false,
      "blacklist": []
    },
    "title#system": {
      "text": "Sistema",
      "clear-all-button": false
    },
    "buttons-grid#system": {
      "buttons-per-row": 3,
      "actions": [
        {"label": "󰕾  Áudio", "command": "colutti-settings-open audio"},
        {"label": "󰖩  Rede", "command": "colutti-settings-open network"},
        {"label": "󰍹  Monitores", "command": "uwsm app -- colutti-settings-gui"},
        {"label": "󰗽  Display externo", "command": "colutti-settings-open displays"},
        {"label": "󰃠  Brilho −", "command": "colutti-brightness-control down"},
        {"label": "󰃠  Brilho +", "command": "colutti-brightness-control up"}
      ]
    },
    "title#session": {
      "text": "Sessão",
      "clear-all-button": false
    },
    "buttons-grid#session": {
      "buttons-per-row": 3,
      "actions": [
        {"label": "󰏘  Aparência", "command": "colutti-settings-open appearance"},
        {"label": "󰅍  Clipboard", "command": "colutti-settings-open clipboard"},
        {"label": "󰒓  Diagnóstico", "command": "colutti-settings-open diagnostics"}
      ]
    },
    "title#power": {
      "text": "Energia e sessão",
      "clear-all-button": false
    },
    "buttons-grid#power": {
      "buttons-per-row": 3,
      "actions": [
        {"label": "󰊗  Modo jogo", "command": "colutti-desktopctl profile game on"},
        {"label": "󰾅  Equilibrado", "command": "colutti-desktopctl profile game off && powerprofilesctl set balanced"},
        {"label": "󰌾  Bloquear", "command": "loginctl lock-session"},
        {"label": "󰤄  Suspender", "command": "systemctl suspend"},
        {"label": "󰍃  Sair", "command": "colutti-session-logout"}
      ]
    },
    "title#help": {
      "text": "Ajuda",
      "clear-all-button": false
    },
    "buttons-grid#help": {
      "buttons-per-row": 1,
      "actions": [
        {"label": "󰌌  Atalhos de teclado", "command": "colutti-shortcuts"}
      ]
    },
    "notifications": {
      "vexpand": true
    }
  }
}
