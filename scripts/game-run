#!/usr/bin/env bash
set -euo pipefail

use_gamescope=false
use_mangohud=false
while (($#)); do
  case "$1" in
    --gamescope)
      use_gamescope=true
      shift
      ;;
    --mangohud)
      use_mangohud=true
      shift
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

(($#)) || {
  printf 'usage: colutti-game-run [--gamescope] [--mangohud] -- COMMAND [ARGS...]\n' >&2
  exit 64
}

prefix=(gamemoderun)
if [[ "${use_gamescope}" == true ]]; then
  gamescope=(gamescope -f)
  if [[ "${use_mangohud}" == true ]]; then
    gamescope+=(--mangoapp)
  fi
  prefix=("${gamescope[@]}" -- "${prefix[@]}")
elif [[ "${use_mangohud}" == true ]]; then
  prefix=(env MANGOHUD=1 "${prefix[@]}")
fi

exec "${prefix[@]}" "$@"
