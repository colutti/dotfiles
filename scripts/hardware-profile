#!/usr/bin/env bash
set -euo pipefail

profile=generic
gpu="unknown"
cpu="unknown"

if command -v lspci >/dev/null 2>&1; then
  gpu="$(lspci -nn | awk -F': ' '/VGA compatible controller|3D controller/ && !seen {print $2; seen=1}')"
  if lspci -nn | grep -Ei 'AMD.*Navi 31|1002:744c' >/dev/null; then
    profile=amd-navi31
  fi
fi
if command -v lscpu >/dev/null 2>&1; then
  cpu="$(lscpu | awk -F': ' '/Model name:/ && !seen {print $2; seen=1}')"
fi

printf 'profile=%s\n' "$profile"
printf 'cpu=%s\n' "$cpu"
printf 'gpu=%s\n' "$gpu"
