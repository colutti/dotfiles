#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
image="${COLUTTI_BOOTSTRAP_IMAGE:-cachyos/cachyos:latest}"

command -v podman >/dev/null 2>&1 || {
  printf 'missing command: podman\n' >&2
  exit 1
}

podman run --rm --pull=missing \
  --volume "${repo_root}:/repo:ro" \
  "$image" bash -ceu '
    pacman -Sy --noconfirm
    cd /repo
    bash -n install.sh
    find scripts -maxdepth 1 -type f -exec bash -n {} +
    ./install.sh bootstrap --dry-run
  '
