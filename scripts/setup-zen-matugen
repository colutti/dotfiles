#!/usr/bin/env bash
set -euo pipefail

zen_root="${COLUTTI_ZEN_ROOT:-${HOME}/.var/app/app.zen_browser.zen/.zen}"
zen_css="${COLUTTI_DMS_ZEN_CSS:-${HOME}/.var/app/app.zen_browser.zen/.zen/colutti-dms-zen.css}"
profiles_ini="${zen_root}/profiles.ini"

if [[ ! -f "$profiles_ini" ]]; then
  printf 'Zen profile not found: %s\n' "$profiles_ini" >&2
  exit 0
fi

profile_path="$(awk -F= '
  /^\[Install/ { in_install=1; next }
  /^\[/ { in_install=0 }
  in_install && $1 == "Default" { print substr($0, index($0, "=") + 1); exit }
' "$profiles_ini")"

if [[ -z "$profile_path" ]]; then
  profile_path="$(awk -F= '
    /^\[Profile[0-9]+\]$/ { in_profile=1; path=""; next }
    /^\[/ { in_profile=0 }
    in_profile && $1 == "Path" { path=substr($0, index($0, "=") + 1) }
    in_profile && $1 == "Default" && $2 == "1" { print path; exit }
  ' "$profiles_ini")"
fi

if [[ -z "$profile_path" ]]; then
  printf 'Zen profile metadata has no default profile: %s\n' "$profiles_ini" >&2
  exit 1
fi

if [[ "$profile_path" = /* ]]; then
  profile_dir="$profile_path"
else
  profile_dir="${zen_root}/${profile_path}"
fi

if [[ ! -d "$profile_dir" ]]; then
  printf 'Zen default profile directory not found: %s\n' "$profile_dir" >&2
  exit 1
fi

chrome_dir="${profile_dir}/chrome"
user_chrome="${chrome_dir}/userChrome.css"
user_js="${profile_dir}/user.js"
mkdir -p "$chrome_dir"

tmp_chrome="$(mktemp "${user_chrome}.tmp.XXXXXX")"
trap 'rm -f -- "$tmp_chrome"' EXIT
if [[ -f "$user_chrome" ]]; then
  awk '
    $0 == "/* BEGIN COLUTTI DMS MATUGEN */" { skip=1; next }
    $0 == "/* END COLUTTI DMS MATUGEN */" { skip=0; next }
    !skip { print }
  ' "$user_chrome" >"$tmp_chrome"
else
  : >"$tmp_chrome"
fi

awk '
  { lines[++count] = $0 }
  END {
    while (count > 0 && lines[count] == "") count--
    for (i = 1; i <= count; i++) print lines[i]
  }
' "$tmp_chrome" >"${tmp_chrome}.trimmed"
mv -- "${tmp_chrome}.trimmed" "$tmp_chrome"

{
  cat "$tmp_chrome"
  [[ ! -s "$tmp_chrome" ]] || printf '\n'
  printf '%s\n' \
    '/* BEGIN COLUTTI DMS MATUGEN */' \
    "@import url(\"file://${zen_css}\");" \
    '/* END COLUTTI DMS MATUGEN */'
} >"${tmp_chrome}.next"
mv -- "${tmp_chrome}.next" "$user_chrome"

if [[ ! -f "$user_js" ]] || ! grep -Fq \
  'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets",' "$user_js"; then
  printf '%s\n' \
    'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);' \
    >>"$user_js"
fi

printf 'Zen Matugen wiring ready: %s\n' "$profile_dir"
