#!/usr/bin/env bash
set -euo pipefail

bus="$(
  ddcutil detect --brief 2>/dev/null |
    awk '
      /I2C bus:/ { bus = $3 }
      /DRM connector:.*HDMI-A-1/ { print bus; exit }
    '
)"
[[ -n "${bus}" ]] || {
  printf 'HDMI-A-1 does not expose a valid DDC bus\n' >&2
  exit 1
}
bus="${bus##*/i2c-}"

current="$(
  ddcutil --bus "${bus}" getvcp 10 2>/dev/null |
    sed -n 's/.*current value = *\([0-9][0-9]*\).*/\1/p'
)"
[[ -n "${current}" ]] || {
  printf 'Unable to read HDMI-A-1 brightness\n' >&2
  exit 1
}

case "${1:-status}" in
  up)
    target=$((current + 5))
    ((target > 100)) && target=100
    ;;
  down)
    target=$((current - 5))
    ((target < 10)) && target=10
    ;;
  status)
    printf '%s\n' "${current}"
    exit 0
    ;;
  *)
    printf 'usage: colutti-brightness-control <up|down|status>\n' >&2
    exit 64
    ;;
esac

ddcutil --bus "${bus}" setvcp 10 "${target}"
notify-send -t 1200 -h "int:value:${target}" \
  "Brilho HDMI" "${target}%"
