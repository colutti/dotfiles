#!/usr/bin/env bash
set -euo pipefail

read -r _ user nice system idle iowait irq softirq steal _ < /proc/stat
total_before=$((user + nice + system + idle + iowait + irq + softirq + steal))
idle_before=$((idle + iowait))
sleep 0.15
read -r _ user nice system idle iowait irq softirq steal _ < /proc/stat
total_after=$((user + nice + system + idle + iowait + irq + softirq + steal))
idle_after=$((idle + iowait))
total_delta=$((total_after - total_before))
idle_delta=$((idle_after - idle_before))
cpu_usage=0
(( total_delta > 0 )) && cpu_usage=$(((total_delta - idle_delta) * 100 / total_delta))

ram_usage="$(free | awk '/Mem:/{printf "%.0f", $3 * 100 / $2}')"
disk_usage="$(df --output=pcent / | awk 'NR==2{gsub(/%/, ""); print $1}')"

hwmon_value() {
  local wanted="$1" directory name
  for directory in /sys/class/hwmon/hwmon*; do
    [[ -r "${directory}/name" ]] || continue
    read -r name <"${directory}/name"
    [[ "${name}" == "${wanted}" ]] || continue
    if [[ -r "${directory}/temp1_input" ]]; then
      awk '{printf "%.0f", $1 / 1000}' "${directory}/temp1_input"
      return
    fi
  done
  printf '?'
}

gpu_busy="?"
for busy in /sys/class/drm/card*/device/gpu_busy_percent; do
  [[ -r "${busy}" ]] || continue
  read -r gpu_busy <"${busy}"
  break
done

printf 'CPU %s%% %s°C · GPU %s%% %s°C · RAM %s%% · SSD %s%%\n' \
  "${cpu_usage}" "$(hwmon_value k10temp)" \
  "${gpu_busy}" "$(hwmon_value amdgpu)" \
  "${ram_usage}" "${disk_usage}"
