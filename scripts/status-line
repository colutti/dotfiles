#!/usr/bin/env bash
set -uo pipefail

parts=()

network="off"
if command -v nmcli >/dev/null 2>&1; then
  if nmcli -t -f TYPE,STATE device status 2>/dev/null |
    grep -q '^wifi:connected$'; then
    network="wifi"
  elif nmcli -t -f TYPE,STATE device status 2>/dev/null |
    grep -q '^ethernet:connected$'; then
    network="ethernet"
  fi
fi
parts+=("NET ${network}")

tailscale_state="off"
if command -v tailscale >/dev/null 2>&1 &&
  tailscale status --json 2>/dev/null |
    jq -e '.BackendState == "Running"' >/dev/null 2>&1; then
  tailscale_state="on"
fi
parts+=("TS ${tailscale_state}")

sink="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true)"
volume="$(
  awk '{printf "%.0f", $2 * 100}' <<<"${sink:-Volume: 0}"
)"
if [[ "${sink}" == *"[MUTED]"* ]]; then
  volume="${volume}% muted"
else
  volume="${volume}%"
fi
parts+=("VOL ${volume}")

source="$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null || true)"
microphone="on"
[[ "${source}" == *"[MUTED]"* ]] && microphone="muted"
parts+=("MIC ${microphone}")

if command -v fuser >/dev/null 2>&1 &&
  fuser /dev/video* >/dev/null 2>&1; then
  parts+=("CAM active")
fi

if command -v pw-dump >/dev/null 2>&1 &&
  pw-dump 2>/dev/null |
    jq -e 'any(.[];
      (.info.props."media.class" // "") == "Stream/Output/Video" and
      ((.info.props."node.name" // "") | ascii_downcase | contains("portal"))
    )' >/dev/null 2>&1; then
  parts+=("SHARE active")
fi

power="$(powerprofilesctl get 2>/dev/null || printf unknown)"
parts+=("PWR ${power}")

joined="$(printf ' · %s' "${parts[@]}")"
printf '%s\n' "${joined:3}"
