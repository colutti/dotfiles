#!/usr/bin/env bash
set -euo pipefail

: "${WAYLAND_DISPLAY:?Hyprland did not export WAYLAND_DISPLAY}"
: "${HYPRLAND_INSTANCE_SIGNATURE:?Hyprland did not export its instance signature}"

export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland

environment=(
  WAYLAND_DISPLAY
  HYPRLAND_INSTANCE_SIGNATURE
  XDG_CURRENT_DESKTOP
  XDG_SESSION_DESKTOP
)
[[ -n "${DISPLAY:-}" ]] && environment+=(DISPLAY)

systemctl --user import-environment "${environment[@]}"
dbus-update-activation-environment --systemd "${environment[@]}"

# Plasma's systemd autostart generator can run before UWSM imports the Hyprland
# desktop variables. Stop only those session helpers here; Plasma itself remains
# untouched and starts them normally in a Plasma session.
plasma_helpers=(
  arch-update-tray.service
  app-discord@autostart.service
  app-steam@autostart.service
  app-org.telegram.desktop@autostart.service
  plasma-foreground-booster.service
  plasma-gmenudbusmenuproxy.service
  plasma-kaccess.service
  plasma-kactivitymanagerd.service
  plasma-powerdevil.service
  plasma-xembedsniproxy.service
)
systemctl --user stop --no-block "${plasma_helpers[@]}" 2>/dev/null || true
systemctl --user reset-failed "${plasma_helpers[@]}" 2>/dev/null || true

systemctl --user reset-failed \
  xdg-desktop-portal-hyprland.service \
  plasma-xdg-desktop-portal-kde.service \
  xdg-desktop-portal-gtk.service || true
systemctl --user restart xdg-desktop-portal-hyprland.service
systemctl --user restart xdg-desktop-portal.service

systemctl --user stop --no-block swaync.service 2>/dev/null || true
systemctl --user stop --no-block colutti-quickshell.service 2>/dev/null || true
systemctl --user disable --now colutti-quickshell.service 2>/dev/null || true
systemctl --user disable --now colutti-desktop.target 2>/dev/null || true
systemctl --user enable --now hypridle.service
systemctl --user start dms.service
systemctl --user start --no-block colutti-session-restore.service
