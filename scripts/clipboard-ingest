#!/usr/bin/env bash
set -euo pipefail

payload_file="$(mktemp)"
trap 'rm -f -- "${payload_file}"' EXIT
head -c 1048576 >"${payload_file}"
[[ -s "${payload_file}" ]] || exit 0

mime="$(file --brief --mime-type -- "${payload_file}")"
case "${mime}" in
  text/*|application/json|application/xml) ;;
  *) exit 0 ;;
esac

if grep -Eqi \
  '(password|passwd|secret|api[_ -]?key|access[_ -]?token|refresh[_ -]?token|BEGIN (RSA |OPENSSH )?PRIVATE KEY|(^|[^0-9])[0-9]{6}([^0-9]|$))' \
  "${payload_file}"; then
  exit 0
fi

cliphist store <"${payload_file}"
