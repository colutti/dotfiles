#!/usr/bin/env bash
set -euo pipefail

run() {
  uwsm app -- "$@" >/dev/null 2>&1 &
}

component="${1:-}"
case "${component}" in
  audio)
    run pavucontrol
    ;;
  network)
    if command -v nm-connection-editor >/dev/null 2>&1; then
      run nm-connection-editor
    else
      run alacritty -e nmtui
    fi
    ;;
  displays)
    if command -v nwg-displays >/dev/null 2>&1; then
      run nwg-displays
    else
      run alacritty -e sh -lc \
        'colutti-desktopctl monitors hdr status; printf "\nUse colutti-desktopctl monitors apply for declarative changes.\n"; read -r'
    fi
    ;;
  appearance)
    if command -v nwg-look >/dev/null 2>&1; then
      run nwg-look
    else
      run colutti-theme-menu
    fi
    ;;
  clipboard)
    if command -v nwg-clipman >/dev/null 2>&1; then
      run nwg-clipman
    else
      run colutti-clipboard-menu
    fi
    ;;
  diagnostics)
    run alacritty -e sh -lc \
      'colutti-desktopctl doctor; printf "\nPress Enter to close.\n"; read -r'
    ;;
  *)
    printf 'usage: colutti-settings-open <audio|network|displays|appearance|clipboard|diagnostics>\n' >&2
    exit 64
    ;;
esac
