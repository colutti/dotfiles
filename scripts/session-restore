#!/usr/bin/env bash
set -uo pipefail

wait_for_hyprland() {
  local attempts=0
  until hyprctl monitors -j >/dev/null 2>&1 && hyprctl workspaces -j >/dev/null 2>&1; do
    (( attempts += 1 ))
    (( attempts < 60 )) || return 1
    sleep 0.25
  done
}

window_address() {
  hyprctl clients -j | jq -r --arg class "$1" \
    '[.[] | select(
      ((.class // "") | ascii_downcase) == ($class | ascii_downcase) or
      ((.initialClass // "") | ascii_downcase) == ($class | ascii_downcase)
    )][0].address // empty'
}

wait_for_window() {
  local class="$1" attempts=0 address
  while (( attempts < 80 )); do
    address="$(window_address "${class}")"
    [[ -n "${address}" ]] && printf '%s\n' "${address}" && return 0
    (( attempts += 1 ))
    sleep 0.25
  done
  return 1
}

reconcile_window() {
  local address="$1" mode="$2" workspace="$3" monitor="$4"
  local width="$5" height="$6" x="$7" y="$8"
  local selector="address:${address}"
  local is_floating=false

  if hyprctl clients -j | jq -e --arg address "${address}" \
    'any(.[]; .address == $address and .floating == true)' >/dev/null; then
    is_floating=true
  fi
  if [[ ("${mode}" == "floating" && "${is_floating}" == false) ||
        ("${mode}" == "tiled" && "${is_floating}" == true) ]]; then
    hyprctl dispatch \
      "hl.dsp.window.float({ action = \"toggle\", window = \"${selector}\" })"
  fi
  hyprctl dispatch \
    "hl.dsp.window.move({ monitor = \"${monitor}\", follow = false, window = \"${selector}\" })"
  hyprctl dispatch \
    "hl.dsp.window.move({ workspace = \"${workspace}\", follow = false, window = \"${selector}\" })"
  if [[ "${mode}" == "floating" ]]; then
    hyprctl dispatch \
      "hl.dsp.window.resize({ x = ${width}, y = ${height}, relative = false, window = \"${selector}\" })"
    hyprctl dispatch \
      "hl.dsp.window.move({ x = ${x}, y = ${y}, relative = false, window = \"${selector}\" })"
  fi
}

reconcile_chat_pair() {
  local telegram discord
  telegram="$(window_address org.telegram.desktop)"
  discord="$(window_address discord)"
  [[ -n "${telegram}" && -n "${discord}" ]] || return 0

  reconcile_window "${telegram}" tiled 6 HDMI-A-1 423 820 0 0
  reconcile_window "${discord}" tiled 6 HDMI-A-1 1053 820 0 0
  hyprctl dispatch \
    "hl.dsp.window.resize({ x = 423, y = 820, relative = false, window = \"address:${telegram}\" })"
}

start_once() {
  local class="$1" mode="$2" workspace="$3" monitor="$4"
  local width="$5" height="$6" x="$7" y="$8"
  local process="$9" desktop="${10}" address="" float_value=false launched=false
  [[ "${mode}" == "floating" ]] && float_value=true

  address="$(window_address "${class}")"
  if [[ -n "${address}" ]]; then
    reconcile_window "${address}" "${mode}" "${workspace}" "${monitor}" \
      "${width}" "${height}" "${x}" "${y}"
    return 0
  fi
  if [[ -z "${address}" ]] && pgrep -f -- "${process}" >/dev/null; then
    address="$(wait_for_window "${class}" || true)"
    if [[ -n "${address}" ]]; then
      reconcile_window "${address}" "${mode}" "${workspace}" "${monitor}" \
        "${width}" "${height}" "${x}" "${y}"
      return 0
    fi
  fi

  if [[ -z "${address}" ]]; then
    hyprctl dispatch \
      "hl.dsp.exec_cmd(\"uwsm app -- ${desktop}\", { workspace = \"${workspace} silent\", monitor = \"${monitor} silent\", float = ${float_value}, size = \"${width} ${height}\", move = \"${x} ${y}\" })"
    launched=true
    address="$(wait_for_window "${class}" || true)"
  fi

  [[ -n "${address}" ]] || return 1
  if [[ "${launched}" == true ]]; then
    reconcile_window \
      "${address}" "${mode}" "${workspace}" "${monitor}" \
      "${width}" "${height}" "${x}" "${y}"
  fi
}

restore_app() {
  local name="$1"
  shift
  if ! "$@"; then
    printf 'restore failed for %s; continuing with remaining applications\n' \
      "${name}" >&2
  fi
}

wait_for_hyprland || {
  printf 'Hyprland did not become ready for session restore\n' >&2
  exit 1
}
hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'
hyprctl dispatch 'hl.dsp.focus({ monitor = "HDMI-A-1" })'
hyprctl dispatch 'hl.dsp.focus({ workspace = 6 })'
hyprctl dispatch 'hl.dsp.focus({ monitor = "DP-2" })'

restore_app Zen start_once app.zen_browser.zen tiled 1 DP-2 2264 1212 20 64 \
  'app\.zen_browser\.zen' "flatpak run app.zen_browser.zen"
restore_app Alacritty start_once Alacritty tiled 2 DP-2 2264 1212 20 64 \
  '(^|/)alacritty([[:space:]]|$)' alacritty
restore_app Steam start_once steam tiled 4 DP-2 2264 1212 20 64 \
  '(^|/)steam([[:space:]]|$)' "env STEAM_FORCE_DESKTOPUI_SCALING=1.75 steam"
restore_app Telegram start_once org.telegram.desktop tiled 6 HDMI-A-1 423 780 404 1360 \
  '(^|/)Telegram([[:space:]]|$)' Telegram
restore_app Discord start_once discord tiled 6 HDMI-A-1 1053 780 847 1360 \
  '(^|/)discord([[:space:]]|$)' discord
reconcile_chat_pair
